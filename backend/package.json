{
  "name": "henrys-liquor-hub-api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p ${PORT:-3001}",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:seed": "docker compose exec -T postgres psql -U henrys -d henrys_liquor_hub -f /seed/001_development_catalogue.sql",
    "db:create-admin": "node scripts/create-admin.mjs",
    "lint": "next lint"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "^15.5.3",
    "nodemailer": "^10.0.13",
    "pg": "^8.13.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.7.2"
  }
}
